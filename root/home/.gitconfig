[alias]
	ad = add
	br = branch
	cm = commit
	cp = cherry-pick
	df = diff
	gr = grep
	lg = log
	rb = rebase
	rs = reset
	rt = restore
	sh = show
	st = status
	sw = switch
	dfc = diff --cached

[include]
	path = ~/catppuccin.gitconfig

[delta]
	features = catppuccin-mocha1
